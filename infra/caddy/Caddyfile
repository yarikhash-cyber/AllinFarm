# AllinFarm web server: serves the site and proxies /api to the API container.
# Locally SITE_ADDRESS is ":8080" (plain HTTP). On a server it becomes the domain,
# and Caddy gets HTTPS certificates by itself.
{
	admin off
}

{$SITE_ADDRESS::8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	handle {
		root * /srv
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
